# Entity: ipn

main: kit: entity: ipn: {

  alias: field: {}

  fields: [
    {
      name: "abbreviation"
      req: false
      short: "The abbreviated name of the timezone"
      type: "`$STRING`"
    }
    {
      name: "client_ip"
      req: false
      short: "The IP address of the client"
      type: "`$STRING`"
    }
    {
      name: "datetime"
      req: false
      short: "The current datetime in ISO 8601 format"
      type: "`$STRING`"
    }
    {
      name: "day_of_week"
      req: false
      short: "The day of the week (0-6, where 0 is Sunday)"
      type: "`$INTEGER`"
    }
    {
      name: "day_of_year"
      req: false
      short: "The day of the year (1-365/366)"
      type: "`$INTEGER`"
    }
    {
      name: "dst"
      req: false
      short: "Whether daylight saving time is currently in effect"
      type: "`$BOOLEAN`"
    }
    {
      name: "dst_from"
      req: false
      short: "The datetime when DST starts"
      type: "`$STRING`"
    }
    {
      name: "dst_offset"
      req: false
      short: "The DST offset in seconds"
      type: "`$INTEGER`"
    }
    {
      name: "dst_until"
      req: false
      short: "The datetime when DST ends"
      type: "`$STRING`"
    }
    {
      name: "raw_offset"
      req: false
      short: "The raw offset from UTC in seconds"
      type: "`$INTEGER`"
    }
    {
      name: "timezone"
      req: false
      short: "The IANA timezone identifier"
      type: "`$STRING`"
    }
    {
      name: "unixtime"
      req: false
      short: "The current Unix timestamp"
      type: "`$INTEGER`"
    }
    {
      name: "utc_datetime"
      req: false
      short: "The current UTC datetime in ISO 8601 format"
      type: "`$STRING`"
    }
    {
      name: "utc_offset"
      req: false
      short: "The UTC offset in ±HH:MM format"
      type: "`$STRING`"
    }
    {
      name: "week_number"
      req: false
      short: "The ISO week number of the year"
      type: "`$INTEGER`"
    }
  ]

  name: "ipn"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "8.8.8.8"
                kind: "param"
                name: "ipv4"
                orig: "ipv4"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/ip/{ipv4}"
          parts: [
            "ip"
            "{ipv4}"
          ]
          select: {
            exist: [
              "ipv4"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "GET"
          orig: "/ip"
          parts: [
            "ip"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "ip"
      ]
    ]
  }



}
