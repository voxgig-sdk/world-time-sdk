              }
            ]
          }
          method: "GET"
          orig: "/ip/{ipv4}"
          parts: [
            "ip"
            "{ipv4}"
          ]
          select: {
            exist: [
              "ipv4"
            ]
          }
          transform: {
            req: "`reqdata`"
